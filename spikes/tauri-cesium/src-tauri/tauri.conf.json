{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lavender Spike",
  "version": "0.0.0",
  "identifier": "systems.noir.lavender.spike",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5410"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Lavender — Tauri × Cesium spike", "width": 1280, "height": 800, "alwaysOnTop": true }],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
