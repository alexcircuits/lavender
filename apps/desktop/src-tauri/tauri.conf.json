{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lavender",
  "version": "0.1.0",
  "identifier": "systems.noir.lavender",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5410"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lavender",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#0a0a0b"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://gibs.earthdata.nasa.gov",
        "connect-src": "'self' ipc: http://ipc.localhost https://gibs.earthdata.nasa.gov",
        "font-src": "'self'",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
